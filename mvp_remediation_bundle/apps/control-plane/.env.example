ENVIRONMENT=dev
DATABASE_URL=sqlite:///./data/lyrics2song.db
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=lyrics2song-jobs
QUEUE_MODE=rq
API_KEYS=dev-api-key
JWT_SECRET=
JWT_ALGORITHM=HS256
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=1.0
DEFAULT_ETA_SECONDS=180
AVAILABLE_MODELS=lyrics2song-demo-v1
RESULT_BASE_URL=https://storage.example.com/results
SIGNED_URL_SECRET=dev-signed-url-secret
SIGNED_URL_TTL_SECONDS=900
WEBSOCKET_POLL_INTERVAL_SECONDS=1.0
SIMULATED_JOB_STEP_SECONDS=0.35
