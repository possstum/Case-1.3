ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://lyrics2song:lyrics2song@127.0.0.1:15432/lyrics2song
REDIS_URL=redis://127.0.0.1:16379/0
QUEUE_NAME=lyrics2song-jobs
QUEUE_MODE=rq
API_KEYS=dev-api-key
JWT_SECRET=dev-jwt-secret
JWT_ALGORITHM=HS256
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=1.0
DEFAULT_ETA_SECONDS=180
AVAILABLE_MODELS=lyrics2song-demo-v1
RESULT_DELIVERY=public
WEBSOCKET_POLL_INTERVAL_SECONDS=1.0
SIMULATED_JOB_STEP_SECONDS=0.35
DEMO_ARTIFACTS_DIR=./data/demo-artifacts
