# Path to the cloned YuE repository root.
YUE_WORKDIR=/path/to/YuE

# Optional overrides when the upstream YuE scripts live elsewhere.
# YUE_FINETUNE_DIR=/path/to/YuE/finetune
# PYTHON_BIN=python3

# Step 1: preprocess_data.sh
PREPROCESS_DATASET_NAME=dummy
PREPROCESS_DATASET_TYPE=cot
TOKENIZER_MODEL_PATH=/path/to/tokenizer.model
# PREPROCESS_EXTRA_ARGS=""

# Step 2: count_tokens.sh
MMAP_DIR=/path/to/YuE/finetune/example/mmap

# Step 3: core/parse_mixture.py
MIXTURE_CONFIG=/path/to/YuE/finetune/example/dummy_data_mixture_cfg.yml
PARSE_MIXTURE_LOG=./out/parse_mixture.log
PARSE_MIXTURE_ENV=./out/mixture.env
# PARSE_MIXTURE_ARGS=""

# Step 4: scripts/run_finetune.sh
# Leave DATA_PATH empty to reuse DATA_PATH from PARSE_MIXTURE_ENV when available.
DATA_PATH=""
DATA_CACHE_PATH=./cache/data
DATA_SPLIT=900,50,50

MODEL_NAME=m-a-p/YuE-s1-7B-anneal-en-cot
MODEL_CACHE_DIR=./cache/models
OUTPUT_DIR=./out/run-001

# Default training parameters.
SEQ_LENGTH=8192
LEARNING_RATE=5e-4
WARMUP_RATIO=0.03
WEIGHT_DECAY=0.01

# Default LoRA parameters.
LORA_R=64
LORA_ALPHA=32
LORA_DROPOUT=0.1
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj

PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=1
NUM_TRAIN_EPOCHS=10
# RUN_FINETUNE_ARGS=""
